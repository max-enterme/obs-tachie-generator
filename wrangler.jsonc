{
  // Cloudflare Workers (Static Assets) — 静的SPAをアセットとして配信するだけの構成。
  // Worker スクリプト(main)は持たない。詳細は DEPLOY.md を参照。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obs-tachie-generator",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
